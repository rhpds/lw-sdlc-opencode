{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "impact-analyzer",
  "agent": {
    "impact-analyzer": {
      "mode": "primary",
      "description": "TPA-aware dependency bump and merge request creation",
      "permission": {
        "skill": {
          "*": "allow",
          "mr-verify-ephemeral": "deny"
        },
        "bash": {
          "*": "allow",
          "python3 /app/scripts/gitlab_api.py *": "allow",
          "python3 scripts/gitlab_api.py *": "allow"
        }
      }
    },
    "mr-verifier": {
      "mode": "primary",
      "description": "Isolated verify, ephemeral deploy, MR feedback",
      "permission": {
        "skill": {
          "dependency-impact-remediation": "deny",
          "mr-verify-ephemeral": "allow"
        },
        "bash": {
          "*": "allow",
          "python3 /app/scripts/gitlab_api.py *": "allow",
          "python3 scripts/gitlab_api.py *": "allow",
          "oc *": "allow",
          "kubectl *": "allow"
        }
      }
    }
  }
}
