{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "impact-analyzer",
  "agent": {
    "impact-analyzer": {
      "mode": "primary",
      "description": "TPA-aware dependency bump and merge request creation",
      "permission": {
        "skill": {
          "*": "allow",
          "mr-verify-ephemeral": "deny"
        },
        "bash": {
          "*": "allow",
          "python3 /app/scripts/gitlab_api.py *": "allow",
          "python3 scripts/gitlab_api.py *": "allow"
        },
        "question": "deny",
        "task": "deny"
      }
    },
    "lightwell-remediation": {
      "mode": "primary",
      "description": "Adapt application source to a Lightwell rebuild. Never edit the dependency.",
      "permission": {
        "edit": {
          "*": "deny",
          "src/main/*": "allow",
          "src/test/*": "allow",
          "REMEDIATION.md": "allow"
        },
        "bash": {
          "*": "deny",
          "git diff*": "allow",
          "git status*": "allow"
        },
        "question": "deny",
        "task": "deny"
      }
    },
    "mr-verifier": {
      "mode": "primary",
      "description": "Isolated verify, ephemeral deploy, MR feedback",
      "permission": {
        "skill": {
          "dependency-impact-remediation": "deny",
          "mr-verify-ephemeral": "allow"
        },
        "bash": {
          "*": "allow",
          "python3 /app/scripts/gitlab_api.py *": "allow",
          "python3 scripts/gitlab_api.py *": "allow",
          "oc *": "allow",
          "kubectl *": "allow"
        },
        "question": "deny",
        "task": "deny"
      }
    }
  }
}
